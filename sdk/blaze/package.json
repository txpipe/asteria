    "@blaze-cardano/data": "^0.6.11",
    "@blaze-cardano/ogmios": "^0.0.8",
    "@blaze-cardano/sdk": "^0.3.3",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^16.6.1",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1"
  }
